{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/chat/completions",
    "bodyPatterns": [
      { "contains": "complex programming question with a code example - fenced JSON answers" },
      { "contains": "Generate a FillInTheBlank Question Type" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "text/event-stream" },
    "bodyFileName": "response-body-question-programming-fill-in-the-blank-fenced.txt",
    "transformers": ["response-template"],
    "chunkedDribbleDelay": { "numberOfChunks": 20, "totalDuration": 1500 }
  }
}
